# ==============================================================================
# ThaliTwin Production Environment Configuration Template
# SaMD Class IIa Clinical Decision Support System
# Happiest Health Digital Twin Challenge 2026
# ==============================================================================

# Server Hosting
HOST=0.0.0.0
PORT=8000
LOKY_MAX_CPU_COUNT=4

# Security: CORS Allowed Origins (Comma-separated or '*' in dev)
# Restrict to trusted frontend domains in production:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501,http://127.0.0.1:5173,http://127.0.0.1:8000,http://127.0.0.1:8501

# Security: Rate Limiting (Maximum requests per minute per IP address)
RATE_LIMIT_PER_MINUTE=120

# Medical Governance: Append-Only Audit Database
# Default: Offline local SQLite. Can be overridden with PostgreSQL in cloud:
# DATABASE_URL=postgresql://user:password@hostname:5432/thalitwin_audit
DATABASE_URL=sqlite:///data/audit_trail.db
